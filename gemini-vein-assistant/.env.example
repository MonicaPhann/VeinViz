# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
GEMINI_MODEL=gemini-flash-lite-latest
# Leave empty if there is no camera on this network: CAMERA_STREAM_URL=
CAMERA_STREAM_URL=http://192.168.1.143:8000/stream
PORT=8080

# Local speech recognition: "auto" times this computer at startup and picks the most accurate model
# that stays quick (small.en, base.en or tiny.en). You can also set one of those directly.
WHISPER_MODEL=auto
