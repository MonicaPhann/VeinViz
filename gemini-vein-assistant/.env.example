# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
GEMINI_MODEL=gemini-flash-lite-latest
# The camera stream on this computer (works on any network). Use http://<ip>:8000/stream if it runs
# on another computer, or leave empty if there's no camera: CAMERA_STREAM_URL=
CAMERA_STREAM_URL=http://127.0.0.1:8000/stream
PORT=8080

# Local speech recognition: "auto" times this computer at startup and picks the most accurate model
# that stays quick (small.en, base.en or tiny.en). You can also set one of those directly.
WHISPER_MODEL=auto
