# Copy this file to .env and fill in your camera. Never commit .env: it contains the camera password.
# Use the Camera Account you created in the Tapo app (Advanced Settings > Camera Account).
# stream1 = full quality, stream2 = lower quality / less lag. A recorded clip path or webcam index (0) also works.
CAMERA_SOURCE=rtsp://USER:PASS@CAMERA_IP:554/stream1
